{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marinjursic.github.io/production-readiness-checklist/schemas/project-config.schema.json",
  "title": "Production Readiness Project Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "assessment", "components", "features", "data", "execution", "remediation"],
  "properties": {
    "schema_version": {"const": "prc.config/v0.1"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "risk_profile"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "risk_profile": {"enum": ["low", "medium", "high", "critical"]}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "source_ref", "artifact_digests", "target_environments"],
      "properties": {
        "profile": {"type": "string", "pattern": "^prc/[a-z0-9-]+$"},
        "source_ref": {"type": "string", "pattern": "^(?:[0-9a-f]{40,64})?$"},
        "artifact_digests": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "target_environments": {"$ref": "#/$defs/names"}
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/component"}
        },
        "exclude": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/exclusion"}
        }
      }
    },
    "features": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,62}$"},
      "additionalProperties": {"type": "boolean"}
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifications", "regulated", "prohibited_in_evidence"],
      "properties": {
        "classifications": {"$ref": "#/$defs/names"},
        "regulated": {"$ref": "#/$defs/names"},
        "prohibited_in_evidence": {"$ref": "#/$defs/names"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "allow_commands", "production_connected", "max_parallel", "max_duration_seconds"],
      "properties": {
        "network": {"const": "deny"},
        "allow_commands": {"type": "array", "maxItems": 0},
        "production_connected": {"const": false},
        "max_parallel": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_duration_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_attempts", "max_files", "max_changed_lines", "protected_paths"],
      "properties": {
        "enabled": {"type": "boolean"},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_files": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_changed_lines": {"type": "integer", "minimum": 1, "maximum": 10000},
        "protected_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "names": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/name"}
    },
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "type": {"enum": ["repository", "web-frontend", "http-api", "service", "worker", "job", "library", "cli", "infrastructure", "container"]}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rationale"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
