{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marinjursic.github.io/production-readiness-checklist/schemas/agent-task.schema.json",
  "title": "Production Readiness Agent Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "mode", "workspace_inventory_digest", "assertion_id", "control_ids", "goal", "read_scope", "relevant_paths", "inputs", "allowed_paths", "protected_paths", "allowed_commands", "network", "secrets", "allow_remote_source_processing", "timeout_seconds", "max_output_bytes", "max_cost_usd"],
  "properties": {
    "schema_version": {"const": "prc.agent-task/v0.1"},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"const": "suggest"},
    "workspace_inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assertion_id": {"type": "string", "pattern": "^PRC-A-[A-Z0-9]+-[0-9]{3}$"},
    "control_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]+-[0-9A-F]{8}$"}},
    "goal": {"type": "string", "minLength": 1, "maxLength": 16384},
    "read_scope": {"const": "task-inputs"},
    "relevant_paths": {"$ref": "#/$defs/paths"},
    "inputs": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/input_file"}},
    "allowed_paths": {"$ref": "#/$defs/nonempty_paths"},
    "protected_paths": {"$ref": "#/$defs/nonempty_paths"},
    "allowed_commands": {"type": "array", "maxItems": 0},
    "network": {"const": "deny"},
    "secrets": {"const": "none"},
    "allow_remote_source_processing": {"const": true},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 4194304},
    "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 1000}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "input_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "content"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content": {"type": "string", "maxLength": 262144}
      }
    },
    "paths": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "nonempty_paths": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
  }
}
