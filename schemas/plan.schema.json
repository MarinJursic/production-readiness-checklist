{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marinjursic.github.io/production-readiness-checklist/schemas/plan.schema.json",
  "title": "Production Readiness Scan Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "digest", "target_name", "inventory_digest", "profile_id", "profile_version", "assertions"],
  "properties": {
    "schema_version": {"const": "prc.plan/v0.1"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_name": {"type": "string", "minLength": 1},
    "target_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_id": {"type": "string", "pattern": "^prc/[a-z0-9-]+$"},
    "profile_version": {"type": "string"},
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "implementation_id", "applicability", "applicability_evaluator"],
        "properties": {
          "assertion_id": {"type": "string"},
          "implementation_id": {"type": "string"},
          "applicability": {"enum": ["applicable", "not_applicable", "undetermined"]},
          "applicability_evaluator": {"type": "string"}
        }
      }
    }
  }
}
