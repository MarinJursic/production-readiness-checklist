{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marinjursic.github.io/production-readiness-checklist/schemas/remediation-candidate-v0.3.schema.json",
  "title": "Production Readiness Remediation Candidate v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "candidate_path", "contract", "candidate_inventory_digest", "candidate_run_id", "changes", "before_assessment", "after_assessment", "accepted", "reasons"],
  "properties": {
    "schema_version": {"const": "prc.remediation-candidate/v0.3"},
    "candidate_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_path": {"type": "string", "minLength": 1},
    "contract": {"$ref": "fix-contract-v0.3.schema.json"},
    "candidate_inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "before_sha256", "after_sha256", "before_mode", "after_mode", "added_lines", "removed_lines"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["modified", "added", "deleted"]},
          "before_sha256": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
          "after_sha256": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
          "before_mode": {"type": "integer", "minimum": 0, "maximum": 511},
          "after_mode": {"type": "integer", "minimum": 0, "maximum": 511},
          "added_lines": {"type": "integer", "minimum": 0},
          "removed_lines": {"type": "integer", "minimum": 0}
        }
      }
    },
    "before_assessment": {"const": "fail"},
    "after_assessment": {"enum": ["pass", "fail", "unknown", "manual_review", "not_applicable", "stale", "conflicting"]},
    "accepted": {"type": "boolean"},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"accepted": {"const": true}}, "required": ["accepted"]},
      "then": {
        "properties": {
          "after_assessment": {"const": "pass"},
          "reasons": {"maxItems": 0}
        }
      },
      "else": {"properties": {"reasons": {"minItems": 1}}}
    }
  ]
}
