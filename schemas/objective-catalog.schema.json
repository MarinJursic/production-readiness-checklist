{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marinjursic.github.io/production-readiness-checklist/schemas/objective-catalog.schema.json",
  "title": "Production Readiness Control Objective Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "objectives"],
  "properties": {
    "schema_version": {"const": "prc.objectives/v0.1"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/objective"}
    }
  },
  "$defs": {
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "title",
        "statement",
        "source",
        "domains",
        "automation_class",
        "assertion_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(PRC-[0-9]{2}-[0-9]{3}|USEQ-[A-F0-9]{8})$"},
        "revision": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "line"],
          "properties": {
            "path": {"type": "string", "pattern": "^docs/.*\\.md$"},
            "line": {"type": "integer", "minimum": 1}
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        },
        "automation_class": {
          "enum": ["automated", "partial", "manual", "external", "contextual", "unmapped"]
        },
        "assertion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PRC-A-[A-Z0-9]+-[0-9]{3}$"}
        }
      }
    }
  }
}
