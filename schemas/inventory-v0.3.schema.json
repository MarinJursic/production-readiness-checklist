{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marinjursic.github.io/production-readiness-checklist/schemas/inventory-v0.3.schema.json",
  "title": "Production Readiness Inventory v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_name", "digest", "file_count", "source_files", "package_ecosystems", "manifests", "lock_files", "container_files", "symlinks", "ci", "infrastructure", "components", "relations", "facts", "files"],
  "properties": {
    "schema_version": {"const": "prc.inventory/v0.3"},
    "target_name": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_count": {"type": "integer", "minimum": 0},
    "source_files": {"type": "integer", "minimum": 0},
    "package_ecosystems": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "manifests": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "lock_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "container_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "symlinks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_actions", "workflow_files"],
      "properties": {
        "github_actions": {"type": "boolean"},
        "workflow_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terraform_files", "kubernetes_files"],
      "properties": {
        "terraform_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "kubernetes_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "declared_scope": {"$ref": "#/$defs/declared_scope"},
    "files": {
      "type": "array",
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "file": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "mode"],
        "properties": {
          "path": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mode": {"type": "integer", "minimum": 0, "maximum": 511}
        }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "path": {"type": "string", "minLength": 1},
        "ecosystem": {"type": "string", "minLength": 1}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "pattern": "^[a-z0-9-]+$"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "source", "detector", "detector_version", "confidence", "scope_path", "limitations"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "value": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "detector": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "detector_version": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "scope_path": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "declared_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_digest", "project_id", "project_name", "risk_profile", "profile_id", "source_ref", "artifact_digests", "target_environments", "components", "exclusions", "features", "data_classifications", "regulated_data", "prohibited_evidence"],
      "properties": {
        "configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "project_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})$"},
        "project_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "risk_profile": {"enum": ["low", "medium", "high", "critical"]},
        "profile_id": {"type": "string", "pattern": "^prc/[a-z0-9-]+$"},
        "source_ref": {"type": "string", "pattern": "^(?:[0-9a-f]{40,64})?$"},
        "artifact_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "target_environments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"}},
        "components": {"type": "array", "items": {"$ref": "#/$defs/declared_component"}},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/declared_exclusion"}},
        "features": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "additionalProperties": {"type": "boolean"}
        },
        "data_classifications": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "regulated_data": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "prohibited_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "declared_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "type": {"type": "string", "pattern": "^[a-z0-9-]+$"}
      }
    },
    "declared_exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rationale"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    }
  }
}
